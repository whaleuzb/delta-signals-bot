{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trade Controller",
  "version": "0.1.3",
  "identifier": "uz.whaleuzb.tradecontroller",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Trade Controller",
    "longDescription": "Trade Controller — signallar, grafik va birja savdosi kompyuterda.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      }
    }
  }
}
